<mxfile host="Electron" version="21.0.0">
  <diagram name="AI Stream Flow" id="ai-stream">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="2" value="AI Chat Stream Flow — MorphCode" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="10" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- 1. Client Request -->
        <mxCell id="3" value="&lt;b&gt;Client: POST /api/chat/stream&lt;/b&gt;&lt;br&gt;{ message, projectId }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="50" width="340" height="55" as="geometry" />
        </mxCell>

        <!-- 2. AiGenerationServiceImpl -->
        <mxCell id="4" value="&lt;b&gt;AiGenerationServiceImpl.streamResponse()&lt;/b&gt;&lt;br&gt;Saves USER ChatMessage to DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="165" width="340" height="55" as="geometry" />
        </mxCell>

        <!-- 3. FileTreeContextAdvisor -->
        <mxCell id="5" value="&lt;b&gt;FileTreeContextAdvisor (StreamAdvisor)&lt;/b&gt;&lt;br&gt;Queries DB for full file list&lt;br&gt;Injects into system prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="340" height="65" as="geometry" />
        </mxCell>

        <!-- Note for step 3 -->
        <mxCell id="12" value="⚠️ DB query on EVERY LLM call — no cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="293" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#d6b656;" edge="1" source="5" target="12" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. ChatClient -->
        <mxCell id="6" value="&lt;b&gt;ChatClient.prompt()&lt;/b&gt;&lt;br&gt;.advisors(fileTreeAdvisor)&lt;br&gt;.tools(new CodeGenerationTools(projectId))&lt;br&gt;.stream()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="405" width="340" height="80" as="geometry" />
        </mxCell>

        <!-- Note for step 4 -->
        <mxCell id="13" value="CodeGenerationTools is NOT a bean — instantiated per-request to bind projectId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="420" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="31" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#9673a6;" edge="1" source="6" target="13" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. OpenRouter -->
        <mxCell id="7" value="&lt;b&gt;OpenRouter API → Gemini Flash&lt;/b&gt;&lt;br&gt;(external LLM provider)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="545" width="340" height="55" as="geometry" />
        </mxCell>

        <!-- 6. LlmResponseParser -->
        <mxCell id="8" value="&lt;b&gt;LlmResponseParser&lt;/b&gt;&lt;br&gt;Buffers stream, regex-parses XML tags:&lt;br&gt;&amp;lt;message&amp;gt;, &amp;lt;file path=&quot;...&quot;&amp;gt;, &amp;lt;tool args=&quot;...&quot;&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="660" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- 7. SSE to Client -->
        <mxCell id="9" value="&lt;b&gt;SSE Stream → Client&lt;/b&gt;&lt;br&gt;Flux&amp;lt;ServerSentEvent&amp;lt;StreamResponse&amp;gt;&amp;gt;&lt;br&gt;ChatEvent records emitted live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="790" width="340" height="65" as="geometry" />
        </mxCell>

        <!-- 8. finalizeChats -->
        <mxCell id="10" value="&lt;b&gt;Stream Complete → finalizeChats()&lt;/b&gt;&lt;br&gt;Runs on Schedulers.boundedElastic() — async" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="915" width="340" height="55" as="geometry" />
        </mxCell>

        <!-- 9. Save to DB -->
        <mxCell id="11" value="Save ASSISTANT ChatMessage&lt;br&gt;+ all ChatEvent records → DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- 10. Write to MinIO -->
        <mxCell id="32" value="Write &amp;lt;file&amp;gt; edits&lt;br&gt;to MinIO (projects bucket)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
