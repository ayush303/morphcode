          <mxGeometry x="60" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- 1. Incoming request -->
        <mxCell id="3" value="&lt;b&gt;Incoming HTTP Request&lt;/b&gt;&lt;br&gt;Authorization: Bearer &amp;lt;token&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
