        <!-- How it works section -->
        <mxCell id="23" value="&lt;b&gt;How it works:&lt;/b&gt; @PreAuthorize(&quot;@security.canEditProject(#projectId)&quot;) → SecurityExpressions bean → projectMemberRepository.findById(ProjectMemberId{userId, projectId}) → role.getPermissions().contains(permission)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="630" height="55" as="geometry" />
        </mxCell>

        <!-- ProjectRole enum note -->
        <mxCell id="24" value="&lt;b&gt;ProjectRole enum:&lt;/b&gt; Each role stores a Set&amp;lt;ProjectPermission&amp;gt;&lt;br&gt;OWNER = {VIEW, EDIT, DELETE, MANAGE_MEMBERS} · EDITOR = {VIEW, EDIT} · VIEWER = {VIEW}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="630" height="50" as="geometry" />
        </mxCell>

